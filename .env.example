# Servidor
PORT=3000
NODE_ENV=development

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=financial_intelligence

# Integración con Google Gemini
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Automatización y Módulo de Investigación
# Intervalo de revisión programada en minutos (por defecto 60)
RESEARCH_SCHEDULE_MINUTES=60
# Activar planificador automático (true/false)
RESEARCH_SCHEDULE_ENABLED=true
# Timeout para consultas HTTP a fuentes externas (milisegundos)
RESEARCH_TIMEOUT_MS=10000
# Máximo de reintentos por fuente fallida
MAX_RETRIES=3

# Token de seguridad para endpoints protegidos de escritura (opcional en dev)
WRITE_API_KEY=dev-secret-tracker-2026
